{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git merge-base *)",
      "Bash(az boards work-item show *)",
      "Bash(az boards query *)",
      "Bash(az repos pr show *)",
      "Bash(az repos pr list *)",
      "Bash(az pipelines runs show *)",
      "Bash(az pipelines runs list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(glab mr view *)",
      "Bash(glab mr diff *)",
      "Bash(glab ci get *)",
      "Bash(glab ci list *)",
      "Bash(glab ci trace *)",
      "Bash(glab issue view *)",
      "Bash(glab issue list *)",
      "Bash(jira issue view *)",
      "Bash(jira issue list *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.dev)",
      "Read(**/.env.staging)",
      "Read(**/.env.production)",
      "Read(**/.env.prod)",
      "Read(**/.env.test)",
      "Read(**/.env.ci)",
      "Read(**/.env.qa)",
      "Read(**/.env.uat)",
      "Read(**/.env.stage)",
      "Read(**/.env.docker)",
      "Read(**/.env.secret)",
      "Read(**/.env.secrets)",
      "Read(**/*-token.json)",
      "Read(**/secrets/**/*.yaml)",
      "Read(**/secrets/**/*.yml)",
      "Read(**/secrets/**/*.json)",
      "Read(**/secrets/**/*.properties)",
      "Read(**/secrets/**/*.env)",
      "Read(**/secrets/**/*.conf)",
      "Read(**/secrets/**/*.txt)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/.npmrc)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.config/gh/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.config/glab-cli/**)",
      "Read(~/.config/.jira/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.m2/settings.xml)",
      "Read(~/.gradle/gradle.properties)",
      "Bash(rm -rf *)",
      "Bash(glab ci get *--with-variables*)"
    ]
  }
}
